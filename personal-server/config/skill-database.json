import fs from 'node:fs';
const DB_PATH = 'F:/projects/FateCovenantClone/personal-server/config/skill-database.json';
const db = JSON.parse(fs.readFileSync(DB_PATH, 'utf8'));
const hero = db.heroes.find(h => h.id === 3030501);
if (!hero) { console.error('hero not found'); process.exit(1); }

const origById = {};
for (const s of hero.skills) origById[s.id] = s.implementation;

function baseImpl(id) {
  const o = origById[id] || {};
  return {
    source: o.source || 'FightTable.Ability + FightTable.AbilityDes',
    resolvedAbility: o.resolvedAbility !== undefined ? o.resolvedAbility : true,
    resolvedDescription: o.resolvedDescription !== undefined ? o.resolvedDescription : true,
    ability: o.ability || null,
    abilityDes: o.abilityDes || null,
    catalogTypeMatch: o.catalogTypeMatch !== undefined ? o.catalogTypeMatch : true,
  };
}

function eff(targetType, effect, durationType, rounds, chance) {
  const o = { target: { targetType }, effect: effect, duration: { durationType: durationType, rounds: rounds }, chance: chance === undefined ? 1 : chance };
  return o;
}
function trig(triggerType, effectObj, opts) {
  opts = opts || {};
  const t = {
    triggerType: triggerType,
    condition: null,
    conditionKey: opts.conditionKey || null,
    cooldown: 0,
    maxTriggers: opts.maxTriggers !== undefined ? opts.maxTriggers : 0,
    oncePerBattle: !!opts.oncePerBattle,
    oncePerRound: !!opts.oncePerRound,
    effect: JSON.parse(JSON.stringify(effectObj)),
    priority: 0,
  };
  if (opts.chance !== undefined) t.chance = opts.chance;
  return t;
}
function D(statType, mag) { return { type: 'stat-modifier', statType: statType, magnitude: mag, isPercentage: true }; }
function ENERGY(energyType, mag) { return { type: 'energy', energyType: energyType, magnitude: mag }; }

function setSkill(id, impl) {
  const s = hero.skills.find(x => x.id === id);
  s.implementation = impl;
}

