syntax = "proto3";
import "general/res.db.proto.txt";

// 资源改变信息
message pb_res_change {
    int64 tid = 1;      // 资源tid
    int64 new_num = 2;  // 改变后的新数值
    sint64 diff_num = 3;// 改变量（增加为正，减少为负）

    bytes new_bin = 4;  // 新的资源数据（编码后的）
                        // 选填字段：当资源对象的改变包含数量以外的信息->将新对象编码成new_bin->传给客户端

    bytes extra = 5;    // 自定义附加数据
                        // 选填字段：当资源的改变包含资源对象本身以外的信息->将额外信息编码为extra->传给外部/客户端

    pb_res_src src = 6; // 资源的来源信息
}

// 资源处理后发送到客户的消息
message pb_res_to_client {
    repeated pb_res_change changes = 1; // 改变量列表
    bool is_overflow = 2;               // 是否有资源溢出
}