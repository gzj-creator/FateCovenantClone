syntax = "proto3";
import "project/wear/skin/skin.db.proto.txt";
import "project/hero/base/hero_base.db.proto.txt";
import "general/res.db.proto.txt";
import "project/attribute/attribute.db.proto.txt";

// 英雄信息
message hero {
    int64 tid = 1;
    int32 count = 2;
    int64 uid = 3;                                                        // 唯一id
    int32 level = 4;                                                    // 等级
    int32 star = 5;                                                        // 星级
    int32 source = 6;                                                   // 来源id
    uint64 lineup_sign = 7;                                             // 阵容标识，按位存储，每一位代表所处的阵容类型
    uint32 breakthrough_level = 8;                                      // 英雄突破等级
    uint64 skin_tid = 9;                                                // 穿戴的皮肤tid
    uint32 quality = 10;                                                // 英雄品质
    uint32 star_progress = 11;                                          // 升星进度
    uint32 exp = 12;                                                    // 升级经验值
    uint32 fantasy_equip = 13;                                          // 幻武uid
    uint32 mutant = 14;                                                 // 变异tid
    bool ignore_fantasy_skin = 15;                                      // 是否忽略幻武皮肤
    uint32 mastery_level = 16;                                          // 专精技能等级
    uint32 mastery_break = 17;                                          // 专精突破等级
    repeated uint32 relic = 18;                                         // 遗物列表
    uint64 sp_relic_level = 19;                                         // 专属遗物等级
    uint64 fantasy_tid = 20;                                            // 幻武tid(显示用)
    uint64 diff = 21;                                                   // 全英雄变异标记（Int类型方便后续拓展，0表示未变异）
    bool rare = 22;                                                     // 是否稀有（升级了稀有为true）
    repeated pb_up_star_high_consume up_star_high_consume = 23;         // 觉醒消耗
    pb_hero_reforge reforge = 24;                                       // 英雄洗练
    int64 sp_relic_refine_value = 25; // 专属遗物(符文)淬炼值
    repeated uint64 source_point_list = 26;                              // 源点uid列表
    repeated pb_hero_pendant_select pendant_select_list = 27;                              // 挂件选择列表
}

// 英雄挂件选择
message pb_hero_pendant_select {
    int32 index = 1; // 部位id
    int64 pendant_tid = 2;                // 挂件tid
}

message hero_source_point_info {
    uint32 index = 1; // 槽位id
    uint32 uid = 2;   // 源点唯一id
    uint32 tid = 3;   // 源点配置id
}

// 英雄总信息
message pb_hero_info {
    repeated hero hero_list = 1;                // 英雄列表
    repeated pb_hero_cell cell_list = 2;        // 英雄格子列表
}

// 碎片合成信息
message chip_compose{
    int64 chip_tid = 1;                                    // 碎片tid
    uint32 guaranteed_count = 2;                            // 次数
}

// 获得的英雄的额外数据
message pb_hero_extra{
    uint32 from = 1;                    // 英雄的来源
    uint32 star = 2;                    // 指定星级
    int64 uid = 3;                      // 指定的uid
    uint64 lineup_sign = 4;             // 上阵标志
}

// 英雄觉醒消耗
message pb_up_star_high_consume {
    int32 star = 1; //星级
    repeated pb_res_obj up_star_high_consume_list = 23;                 // 道具消耗列表
}

// 英雄洗练
message pb_hero_reforge{
    repeated pb_attr_item attr_list = 1;                //当前属性列表
    repeated pb_attr_item random_attr_list = 2;                //随机属性列表(可替换或放弃)
}