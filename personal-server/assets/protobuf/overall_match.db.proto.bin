syntax = "proto3";

// 全服匹配数据快照，数据库 Key 固定为 ServerId = 0
message pb_overall_match_data {
    repeated pb_overall_match_region_data region_data_list = 1;
}

message pb_overall_match_region_data {
    uint32 region_id = 1;
    repeated pb_overall_match_type_data type_data_list = 2;
}

// 单个角色的全服匹配数据
message pb_overall_match_type_data {
    int32 match_type = 1;
    repeated pb_overall_match_role_data role_data_list = 2;
}

// 某个匹配类型下的角色匹配状态
message pb_overall_match_role_data {
    int64 role_id = 1;
    int32 rank = 2;
    int32 power = 3; 
}