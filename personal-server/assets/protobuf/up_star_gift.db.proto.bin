syntax = "proto3";
import "project/recharge/recharge_limit.db.proto.txt";

// 限时升星活动总数据
message pb_up_star_gift_master{
    repeated pb_time_limit_up_star info_list = 1; // 所有升星活动数据列表
    uint32 cur_choose_version = 2;                // 当前选择的活动版本，同时开多期的活动，可以动态选择参加哪项活动
}

// 一次限时升星的活动数据
message pb_time_limit_up_star{
    uint32 version = 1;  // 活动版本
    uint64 act_id = 2;   // 活动ID
    bytes award_bin = 3; // 升星奖励领取记录
    pb_recharge_limit_info buy_limit_info = 4; // 礼包限购记录
}