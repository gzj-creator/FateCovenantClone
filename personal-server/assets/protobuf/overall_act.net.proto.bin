syntax = "proto3";

import "project/recharge/recharge_limit.db.proto.txt";
import "project/shop.db.proto.txt";
import "general/res.net.proto.txt";

// 周年庆主活动开启活动
message pb_overall_act_enter_running {
  pb_shop_info_list shop_info_list = 1; // 商店信息
}

// 周年庆付费返回
message pb_overall_act_recharge_rsp {
  pb_recharge_limit_info recharge_limit = 1; // 充值限制信息
  pb_res_to_client res = 2; // 资源变化(折扣券)
}