syntax = "proto3";

import "general/res.db.proto.txt";

message pb_audit_collect {
  uint32 time_stamp = 1;    // 数据更新时间(应对服务器关闭期间跨天的情况)
  repeated pb_audit_collect_item items = 2;  // 审计物资变化情况
}

message pb_audit_collect_item {
  uint64 tid = 1;
  uint64 add = 2;
  uint64 consume = 3;
  int64 yesterday_storage = 4;
}