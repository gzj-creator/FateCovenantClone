syntax = "proto3";
import "project/lineup_snapshot/lineup_snapshot.db.proto.txt";

// 地图节点数据
message pb_common_map_node{
    uint32 x = 1;   // x轴
    uint32 y = 2;   // y轴
    uint32 type = 3;     // 类型
    uint32 db_data = 4;  // 节点数据库数据（初始化随机）
    uint32 cfg_data = 5; // 节点配置数据（需要才会存）
    bool is_over = 6;    // 是否结束
    bytes ext_data = 7;  // 节点额外的结构数据
}

// 战斗节点额外数据 - 魔灵玩法
message pb_common_map_node_ext_fight{
    pb_lineup_snapshot_key key = 1; // 镜像阵容key
    uint64 init_day = 2; // 初始化天数索引(用于属性削弱)
}

// 地图数据
message pb_common_map{
    uint32 x = 1;   // x轴
    uint32 y = 2;   // y轴
    repeated pb_common_map_node line_list = 3;      //线路列表（线路和事件拆分开，防止过长）
    repeated pb_common_map_node evt_list = 4;       //事件列表（线路和事件拆分开，防止过长）
    repeated uint32 buff_list = 5;                  //生效buff列表
    pb_common_map_node_over_data over_data = 6;     //完成节点记录的额外数据
}

// 地图完成节点记录的额外数据
message pb_common_map_node_over_data{
    repeated uint32 select_option_list = 1;     // 已经选过的选项ID列表
}