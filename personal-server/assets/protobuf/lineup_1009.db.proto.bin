syntax = "proto3";

import "project/lineup.db.proto.txt";

// 数据修复使用,旧版本阵容,减少被其他模块引用,所以单独建了一个文件

// 角色阵容数据
message pb_role_lineup_ver_1009 {
  repeated pb_pre_lineup_ver_1009 pre_lineups = 1; // 预设阵容
  uint32 cur_pre_index = 2; // 当前查看的预设阵容
}

message pb_pre_lineup_ver_1009 {
  uint32 index = 1;
  pb_lineup_team_ver_1009 lineup = 2;
}


message pb_lineup_ver_1009 {
  int32 type = 1; // 布阵类型
  repeated pb_lineup_team_ver_1009 team_list = 2;
  repeated pb_lineup_custom_attr custom_attr = 3; // 阵容自定义属性
}

message pb_lineup_team_ver_1009 {
  int32 team_id = 1; //  队伍ID
  uint64 max_power = 2; // 历史最大战力
  repeated pb_lineup_fighter_ver_1009 fighter_list = 3; // 当前上阵的战斗者
  repeated int32 artifact_list = 4; //上阵圣约tid列表
  uint64 power = 5; // 当前战力，目前用于向客户端发送战力值，客户端暂时没有提供计算战力的方式
  repeated pb_lineup_lease_fighter lease_fighter_list = 6; // 租借英雄
  repeated uint32 pet_list = 7; // 上阵宠物
}

// 阵容中的战斗者
message pb_lineup_fighter_ver_1009 {
  uint32 loc = 1;         // 站位
  uint32 index = 2;       // 在养成界面的格子位置
  uint64 hero_id = 3;     // 英雄唯一id(即英雄表tid，因为现在一个英雄tid只会有一个，多的会转为碎片)
  repeated uint32 equip_ids = 4; // 穿戴的装备
  uint64 power = 5;       // 战力
  uint32 fetter_tid = 6;  // 龙魂羁绊英雄tid
  repeated uint64 source_stones = 7; //装备的源石列表      注意：本次更新去除字段
  repeated uint64 relic_ids = 8; //装备的遗物列表          注意：本次更新去除字段
  uint32 fantasy_equip = 13; //穿戴的幻武uid(逻辑待添加)    注意：本次更新去除字段
}

