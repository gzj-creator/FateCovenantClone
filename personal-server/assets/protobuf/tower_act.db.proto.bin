syntax = "proto3";

import "general/res.db.proto.txt";
import "project/recharge/recharge_limit.db.proto.txt";

// 爬塔活动角色数据
message pb_tower_act_role {
  uint32 act_tid = 1; // 活动id
  uint32 step = 2; // 当前爬塔步数
  repeated pb_res_obj award_list = 3;     // 提前确定的奖励列表
  bytes got_task_award = 4; // 已经领取的任务奖励
  pb_recharge_limit_info buy_limit_info = 5;   // 充值购买次数信息
  uint32 award_group = 6; // 大奖奖励组
  uint32 turn = 7; // 当前轮数
}