syntax = "proto3";

// 充值返利抽奖玩家数据
message pb_cashback_draw_role_info {
  repeated pb_cashback_draw_act_info act_list = 1;           //活动信息列表
}

// 充值返利抽奖活动数据
message pb_cashback_draw_act_info {
  int64 version = 1;                                   //活动表version
  int64 draw_times = 2;                                //已用抽奖次数
  int64 get_times = 3;                                 //获得的抽奖次数
  repeated int64 server_get_list = 4;                  // 全服奖励领取记录
  repeated pb_cashback_draw_turn_info turn_list = 5;   // 抽奖轮次信息
}

// 充值返利抽奖轮次数据
message pb_cashback_draw_turn_info {
  int64 turn = 1;                                      //轮次
  repeated int64 get_list = 2;                         //任务完成列表
}

// 充值返利抽奖服务器数据
message pb_cashback_draw_server_info {
  repeated pb_cashback_draw_server_act_info act_list = 1;           //活动信息
}

// 充值返利抽奖活动服务器数据
message pb_cashback_draw_server_act_info {
  int64 draw_times = 1;                                //全服抽奖次数
  int64 version = 2;                                   // 版本号
}