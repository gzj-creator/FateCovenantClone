syntax = "proto3";


// 通用任务活动玩家数据
message pb_task_activity_role_info {
  repeated pb_task_activity_info act_list = 1;           //活动信息
}

// 通用任务活动数据
message pb_task_activity_info {
  int64 version = 1;                                   //活动表version
  repeated int64 finish_task_list = 2;                 // 任务完成列表
}