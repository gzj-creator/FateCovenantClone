syntax = "proto3";


// 时空符文 - 整体数据结构
message pb_norse_rune {
    repeated pb_norse_rune_token token_list = 1; // 信物数据列表
    repeated pb_norse_rune_type type_list = 2; // 类型数据列表
    uint32 level = 3; //当前祈福等级
    uint32 exp = 4; //当前祈福经验
    pb_norse_rune_token draw_token = 5; // 当前抽取的信物
}

// 时空符文 - 符文类型数据
message pb_norse_rune_type {
    uint32 type = 1;     // 时空符文类型tid
    uint32 level = 2; // 时空符文类型等级
}

// 时空符文 - 信物数据
message pb_norse_rune_token {
    uint32 token = 1; //信物的tid
    uint32 level = 2; //信物的等级
    uint32 quality = 3; //信物的品质
}