syntax = "proto3";
import "project/activity/hundred_draw_act/hundred_draw_act.db.proto.txt";
import "general/res.net.proto.txt";

// 抽奖
message pb_hundred_act_draw_req{
  int64 act_id = 1;
  int64 times = 2;
}

message pb_hundred_act_draw_rsp{
  pb_hundred_draw_act_data act_data = 1; // 最新活动数据
  pb_res_to_client res = 2; // 资源变化
}

// 领取进度奖励
message pb_hundred_act_receive_process_award_req{
  int64 act_id = 1;
  repeated int64 tid_list = 2;
}

message pb_hundred_act_receive_process_award_rsp{
  pb_hundred_draw_act_data act_data = 1; // 最新活动数据
  pb_res_to_client res = 2; // 资源变化
}

// 选择大奖
message pb_hundred_draw_act_select_award_req{
  int64 act_id = 1;
  int64 target_tid = 2;
}

message pb_hundred_draw_act_select_award_rsp{
  pb_hundred_draw_act_data act_data = 1; // 最新活动数据
}

// 领取升星奖励
message pb_hundred_draw_act_rec_star_award_req{
  int64 act_id = 1;
  repeated int64 tid_list = 2;
}

message pb_hundred_draw_act_rec_star_award_rsp{
  pb_hundred_draw_act_data act_data = 1; // 最新活动数据
  pb_res_to_client res = 2; // 资源变化
}

// 获取跑马灯
message pb_hundred_draw_act_marquee_req{
  int64 act_id = 1;
  int64 start_range = 2;
  int64 end_range = 3;
}

message pb_hundred_draw_act_marquee_rsp{
  pb_hundred_draw_overall_marquee_data data = 1; // 跑马灯数据
}