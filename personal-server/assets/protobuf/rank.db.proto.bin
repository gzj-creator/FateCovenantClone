syntax = "proto3";

// 排行榜存储
message pb_rank_store{
    repeated pb_rank_obj rank_obj_list = 1;
}

// 排行榜值对象
message pb_rank_obj{
    int64 id = 1;
    int64 value = 2;
    bytes extra = 3;
}

// 排行榜备份数据
message pb_rank_backup{
    repeated pb_rank_obj rank_list = 1;
}

// 排行榜气泡数据
message pb_rank_bubble{
    uint32 type = 1;            //类型
    string notice = 2;          //气泡内容
}